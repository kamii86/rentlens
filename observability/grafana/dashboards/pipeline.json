      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(rentlens_api_requests_total{route=~\"/api/v1/tasks.*\",status_code=\"503\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(rentlens_api_requests_total{route=~\"/api/v1/tasks.*\"}[$__rate_interval])), 1e-9)",
