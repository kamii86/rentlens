DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/rentlens
MLFLOW_DB_PASSWORD=your_local_password

LOG_LEVEL=INFO
DEPLOYMENT_ENVIRONMENT=local
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.1,deployment.environment.name=local
OTEL_METRIC_EXPORT_INTERVAL=5000

OTEL_COLLECTOR_VERSION=0.165.0
TEMPO_VERSION=2.10.7
PROMETHEUS_VERSION=v3.16.0
APP_IMAGE_TAG=0.1.1-hw5

QUEUE_MODE=bounded
QUEUE_LIMIT=10
PREFETCH_COUNT=1
WORKER_CONCURRENCY=1
INFERENCE_SECONDS=2.0
MAX_ATTEMPTS=3
GRACEFUL_TIMEOUT=40
STOP_GRACE_PERIOD=50s
BATCH_COUNT=120

LOKI_VERSION=3.6.20
ALLOY_VERSION=v1.21.2
GRAFANA_VERSION=13.3.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rentlens-local-admin
DOCKER_SOCKET_PATH=/var/run/docker.sock
